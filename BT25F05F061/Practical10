#include <stdio.h>

int graph[20][20];
int visited[20];
int n;

void DFS(int vertex)
{
int i;

printf("%d ", vertex);
visited[vertex] = 1;

for (i = 0; i < n; i++)
{
    if (graph[vertex][i] == 1 && visited[i] == 0)
    {
        DFS(i);
    }
}

}

int main()
{
int i, u, v, edges, start;

printf("Enter number of vertices: ");
scanf("%d", &n);

for (i = 0; i < n; i++)
    visited[i] = 0;

printf("Enter number of edges: ");
scanf("%d", &edges);

printf("Enter edges (u v):\n");

for (i = 0; i < edges; i++)
{
    scanf("%d %d", &u, &v);
    graph[u][v] = 1;
    graph[v][u] = 1;
}

printf("Enter starting vertex (0 to %d): ", n - 1);
scanf("%d", &start);

printf("DFS Traversal: ");
DFS(start);

return 0;

}
